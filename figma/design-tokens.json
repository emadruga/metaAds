{
  "meta": {
    "name": "MetAds Design System",
    "version": "1.0.0",
    "description": "Design tokens for MetAds - Ad Intelligence Platform"
  },

  "colors": {
    "primary": {
      "50": "#EEF2FF",
      "100": "#E0E7FF",
      "200": "#C7D2FE",
      "300": "#A5B4FC",
      "400": "#818CF8",
      "500": "#6366F1",
      "600": "#4F46E5",
      "700": "#4338CA",
      "800": "#3730A3",
      "900": "#312E81",
      "description": "Primary brand color - Indigo"
    },

    "gray": {
      "50": "#F9FAFB",
      "100": "#F3F4F6",
      "200": "#E5E7EB",
      "300": "#D1D5DB",
      "400": "#9CA3AF",
      "500": "#6B7280",
      "600": "#4B5563",
      "700": "#374151",
      "800": "#1F2937",
      "900": "#111827",
      "description": "Neutral grays for text and backgrounds"
    },

    "success": {
      "light": "#D1FAE5",
      "main": "#10B981",
      "dark": "#065F46",
      "description": "Active status, success states"
    },

    "warning": {
      "light": "#FEF3C7",
      "main": "#F59E0B",
      "dark": "#92400E",
      "description": "Warnings, attention needed"
    },

    "error": {
      "light": "#FEE2E2",
      "main": "#EF4444",
      "dark": "#991B1B",
      "description": "Errors, destructive actions"
    },

    "semantic": {
      "background": "#FFFFFF",
      "backgroundSecondary": "#F9FAFB",
      "surface": "#FFFFFF",
      "border": "#E5E7EB",
      "borderFocus": "#6366F1",
      "textPrimary": "#111827",
      "textSecondary": "#6B7280",
      "textTertiary": "#9CA3AF",
      "textInverse": "#FFFFFF"
    },

    "platforms": {
      "instagram": "#E4405F",
      "facebook": "#1877F2",
      "messenger": "#0099FF",
      "audienceNetwork": "#6B7280",
      "description": "Platform-specific brand colors"
    },

    "badges": {
      "daysActive": {
        "background": "#EEF2FF",
        "text": "#4338CA",
        "description": "Days active badge"
      },
      "variants": {
        "background": "#FEF3C7",
        "text": "#92400E",
        "description": "Variant count badge"
      },
      "longest": {
        "background": "#D1FAE5",
        "text": "#065F46",
        "description": "Longest running variant badge"
      },
      "newest": {
        "background": "#DBEAFE",
        "text": "#1E40AF",
        "description": "Newest variant badge"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "primary": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "SF Mono, Monaco, 'Cascadia Code', monospace"
    },

    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px"
    },

    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },

    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.75
    },

    "styles": {
      "heading1": {
        "fontSize": "24px",
        "fontWeight": 700,
        "lineHeight": 1.25,
        "usage": "Page titles"
      },
      "heading2": {
        "fontSize": "20px",
        "fontWeight": 600,
        "lineHeight": 1.25,
        "usage": "Section headers"
      },
      "heading3": {
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": 1.25,
        "usage": "Card titles, page names"
      },
      "bodyLarge": {
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "usage": "Primary body text"
      },
      "body": {
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "usage": "Default body text, headlines"
      },
      "bodySmall": {
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "usage": "Meta info, captions"
      },
      "label": {
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.25,
        "letterSpacing": "0.05em",
        "textTransform": "uppercase",
        "usage": "Section labels, filter labels"
      },
      "badge": {
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": 1,
        "usage": "Badge text"
      }
    }
  },

  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",

    "semantic": {
      "cardPadding": "16px",
      "cardMargin": "8px",
      "sectionGap": "24px",
      "inputPadding": "12px 16px",
      "buttonPadding": "12px 24px",
      "badgePadding": "4px 8px",
      "thumbnailMargin": "12px"
    }
  },

  "borderRadius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px",

    "semantic": {
      "card": "8px",
      "button": "8px",
      "input": "8px",
      "badge": "4px",
      "thumbnail": "8px",
      "avatar": "9999px"
    }
  },

  "shadows": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",

    "semantic": {
      "card": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "cardHover": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "dropdown": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
      "modal": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
    }
  },

  "breakpoints": {
    "mobile": "0px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1280px"
  },

  "dimensions": {
    "desktop": {
      "searchPanelWidth": "250px",
      "resultsListWidth": "350px",
      "adDetailMinWidth": "400px",
      "headerHeight": "64px"
    },
    "mobile": {
      "bottomNavHeight": "56px",
      "headerHeight": "56px"
    },
    "components": {
      "thumbnailDesktop": "60px",
      "thumbnailMobile": "80px",
      "buttonHeight": "44px",
      "inputHeight": "44px",
      "badgeHeight": "24px"
    }
  },

  "transitions": {
    "fast": "150ms ease",
    "normal": "200ms ease",
    "slow": "300ms ease",

    "semantic": {
      "hover": "150ms ease",
      "focus": "150ms ease",
      "expand": "300ms ease",
      "pageTransition": "200ms ease"
    }
  },

  "zIndex": {
    "base": 0,
    "dropdown": 10,
    "sticky": 20,
    "overlay": 30,
    "modal": 40,
    "toast": 50
  }
}

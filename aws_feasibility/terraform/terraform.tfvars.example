# ============================================================================
# MetaAds AWS Feasibility Test - Configuration Example
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to terraform.tfvars
#    cp terraform.tfvars.example terraform.tfvars
# 2. Fill in your values below
# 3. NEVER commit terraform.tfvars to version control (it's gitignored)
# ============================================================================

# ============================================================================
# AWS Configuration
# ============================================================================

# AWS region where resources will be created
# Recommended: us-east-1 (lowest cost, most services)
# Options: us-east-1, us-west-2, eu-west-1, etc.
aws_region = "us-east-1"

# Environment name (for tagging)
environment = "feasibility-test"

# ============================================================================
# EC2 Configuration
# ============================================================================

# Instance type
# t3.micro = Free Tier eligible, 2 vCPU, 1 GB RAM (~$7.50/month)
# t3.small = 2 vCPU, 2 GB RAM (~$15/month)
# t3.medium = 2 vCPU, 4 GB RAM (~$30/month)
instance_type = "t3.micro"

# SSH key pair name (MUST ALREADY EXIST in your AWS account)
# To create a key pair:
# aws ec2 create-key-pair --key-name metaads-test --query 'KeyMaterial' --output text > ~/.ssh/metaads-test.pem
# chmod 400 ~/.ssh/metaads-test.pem
key_name = "your-key-name-here"  # CHANGE THIS!

# Root EBS volume size in GB
# Minimum: 8 GB (sufficient for testing)
# Recommended: 20 GB (allows for data collection)
root_volume_size = 20

# ============================================================================
# Network Configuration
# ============================================================================

# IP addresses/ranges allowed to SSH into the instance
# For maximum security, use your specific IP:
#   allowed_ssh_cidr = ["YOUR_IP/32"]
# To find your IP: curl ifconfig.me
# For testing from anywhere (less secure):
#   allowed_ssh_cidr = ["0.0.0.0/0"]
allowed_ssh_cidr = ["0.0.0.0/0"]  # CHANGE THIS for production!

# Whether to use an Elastic IP (persistent public IP)
# false = Use regular public IP (changes on stop/start)
# true = Allocate Elastic IP (persistent, small cost when instance stopped)
use_elastic_ip = false

# ============================================================================
# Application Configuration
# ============================================================================

# Your GitHub repository URL
# IMPORTANT: Update this to your forked repository or keep as is
github_repo_url = "https://github.com/yourusername/metaAds.git"  # CHANGE THIS!

# Git branch to checkout
github_branch = "main"

# ============================================================================
# Monitoring Configuration
# ============================================================================

# CloudWatch log retention in days
# Options: 1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180
log_retention_days = 7

# Enable CloudWatch monitoring and alarms
enable_monitoring = true

# ============================================================================
# Optional: Additional Tags
# ============================================================================

# Add custom tags to all resources (optional)
additional_tags = {
  Owner   = "YourName"
  Team    = "Engineering"
  Purpose = "MetaAds-Testing"
}

# ============================================================================
# Configuration Examples for Different Scenarios
# ============================================================================

# SCENARIO 1: Quick Test (Minimal Cost)
# instance_type = "t3.micro"
# root_volume_size = 8
# use_elastic_ip = false
# enable_monitoring = false

# SCENARIO 2: Full Feasibility Test (Recommended)
# instance_type = "t3.micro"
# root_volume_size = 20
# use_elastic_ip = false
# enable_monitoring = true

# SCENARIO 3: Production-Like Test
# instance_type = "t3.small"
# root_volume_size = 30
# use_elastic_ip = true
# enable_monitoring = true

# ============================================================================
# Cost Estimates (approximate, varies by region)
# ============================================================================

# t3.micro + 20GB EBS:
#   - Free Tier: $0/month (750 hours/month free for 12 months)
#   - Regular: ~$9.50/month
#
# t3.small + 30GB EBS:
#   - Regular: ~$18/month
#
# Elastic IP:
#   - Free while attached to running instance
#   - $3.65/month if not attached (720 hours × $0.005)
#
# Data Transfer:
#   - First 100GB/month free
#   - Negligible for this workload

# ============================================================================

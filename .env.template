# .env.template
# Copy this file to .env and fill in your credentials

# =============================================================================
# Meta API Configuration
# =============================================================================
# Get your access token from: https://developers.facebook.com/apps
# Graph API Explorer → Generate Token (permissions: ads_read, pages_read_engagement)
# Token expires every 60 days - update before expiration
FB_ACCESS_TOKEN="YOUR_FACEBOOK_ACCESS_TOKEN_HERE"

# =============================================================================
# Clerk Authentication (Backend Secrets - Optional)
# =============================================================================
# These are backend secrets used by AWS Secrets Manager
# The publishable key is already in frontend/.env
# Only add these here if you want to avoid manual prompts during deployment
#
# Get from: https://dashboard.clerk.com → API Keys
# CLERK_SECRET_KEY="sk_test_..."
#
# Get from: https://dashboard.clerk.com → Webhooks
# CLERK_WEBHOOK_SECRET="whsec_..."

# =============================================================================
# Slack (Optional)
# =============================================================================
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# =============================================================================
# Database (Optional - default: data/ads_intelligence.db)
# =============================================================================
# DB_PATH="data/ads_intelligence.db"

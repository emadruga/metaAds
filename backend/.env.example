# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///../data/ads_intelligence.db

# CORS
CORS_ORIGINS=http://localhost:5173

# Dev Mode - Bypass authentication for local testing
# Set to true to test API without Clerk setup
DEV_AUTH_BYPASS=true
DEV_USER_ID=dev_user_001

# Clerk Authentication (required when DEV_AUTH_BYPASS=false)
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meta Ad Library API
# Get from https://developers.facebook.com/apps
FB_ACCESS_TOKEN=your_meta_access_token_here

# Rate Limiting
API_RATE_LIMIT=200
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=5

# Analysis Settings
MIN_AD_DAYS_ACTIVE=30
TOP_N_KEYWORDS=50
